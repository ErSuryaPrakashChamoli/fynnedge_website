APP_NAME=FynnEdge
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Default for "Allow search engine indexing" until an admin saves that setting
# in the panel. Set to false on staging/dev so a database copied from production
# cannot bring an indexable setting with it.
SEO_INDEXING_ENABLED=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fynnedge
DB_USERNAME=fynnedge
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production once the site is served over HTTPS.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Mobile OTP over SMS (docs/mobile-otp-integration.md).
# "areach" sends real SMS. "log" writes the message to storage/logs instead and
# only works with APP_ENV=local — it refuses to send anywhere else.
MOBILE_OTP_SMS_PROVIDER=areach
AREACH_BASE_URL=https://api.areach.in/v1
# Server-side secret. Set it in the server's environment; never commit a value.
AREACH_API_KEY=
AREACH_SENDER=FYNNED
AREACH_SMS_TIMEOUT=10

# Google Cloud Translation API key: Hindi for content saved in the admin.
GOOGLE_TRANSLATE_API_KEY=

# Surepass CRIF credit reports (docs/crif-credit-report-integration.md).
# Every report fetch is a paid call. Server-side secret: set the token in the
# server's environment only; never commit a value.
SUREPASS_BASE_URL=https://kyc-api.surepass.app
SUREPASS_BEARER_TOKEN=
SUREPASS_TIMEOUT=60
SUREPASS_CONNECT_TIMEOUT=10
# Free CRIF Score page: "report" (full-report endpoint) or "score" (score endpoint, if your plan includes it).
SUREPASS_CRIF_PUBLIC_SCORE_SOURCE=report
# Free Equifax Score page: "report" (credit-report-v2/fetch-report) or "score" (credit-report-v2/score, if your plan includes it).
SUREPASS_EQUIFAX_PUBLIC_SCORE_SOURCE=report
# Optional: a separate token / base URL for Equifax only. Blank = the SUREPASS_ ones above.
SUREPASS_EQUIFAX_TOKEN=
SUREPASS_EQUIFAX_BASE_URL=
# Experian (docs/experian-credit-bureau-integration.md). Optional own token / base URL; blank = the SUREPASS_ ones above.
SUREPASS_EXPERIAN_TOKEN=
SUREPASS_EXPERIAN_BASE_URL=
# Free Experian Score page: "report" (credit-report-experian/fetch-report) or "score" (score endpoint, if your plan includes it).
SUREPASS_EXPERIAN_PUBLIC_SCORE_SOURCE=report
MOBILE_OTP_LENGTH=6
MOBILE_OTP_EXPIRY_MINUTES=10
MOBILE_OTP_MAX_ATTEMPTS=5
MOBILE_OTP_RESEND_COOLDOWN_SECONDS=60
MOBILE_OTP_MAX_SENDS_PER_NUMBER_PER_HOUR=5
MOBILE_OTP_MAX_SENDS_PER_IP_PER_HOUR=20
MOBILE_OTP_VERIFIED_TTL_MINUTES=30
# Only true while running `php artisan mobile-otp:smoke-test`, then back to false.
MOBILE_OTP_LIVE_TEST_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
